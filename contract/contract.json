{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdaptAI Contract",
  "description": "Frozen API Request and Response contract between Module 1 (Extension) and Module 2 (AI)",
  "requestSchema": {
    "type": "object",
    "required": ["mode", "userPreference", "page"],
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["PERSONA", "AI_ADAPT", "SIMPLIFY", "DESCRIBE_IMAGE", "VOICE_COMMAND", "REPORT"]
      },
      "userPreference": {
        "type": "string"
      },
      "page": {
        "type": "object",
        "required": ["title", "headings", "buttons", "paragraphCount", "imageCount", "navigationItems", "sampleText"],
        "properties": {
          "title": { "type": "string" },
          "headings": { "type": "array", "items": { "type": "string" } },
          "buttons": { "type": "array", "items": { "type": "string" } },
          "paragraphCount": { "type": "integer" },
          "imageCount": { "type": "integer" },
          "navigationItems": { "type": "integer" },
          "sampleText": { "type": "string" }
        }
      },
      "imageUrl": {
        "type": ["string", "null"]
      },
      "voiceTranscript": {
        "type": ["string", "null"]
      }
    }
  },
  "responseSchema": {
    "type": "object",
    "required": [
      "fontScale",
      "lineHeight",
      "highContrast",
      "hideAnimations",
      "enlargeButtons",
      "simplifyText",
      "describeImages",
      "reduceNavigation"
    ],
    "properties": {
      "fontScale": { "type": "number" },
      "lineHeight": { "type": "number" },
      "highContrast": { "type": "boolean" },
      "hideAnimations": { "type": "boolean" },
      "enlargeButtons": { "type": "boolean" },
      "simplifyText": { "type": "boolean" },
      "simplifiedText": { "type": ["string", "null"] },
      "describeImages": { "type": "boolean" },
      "imageDescription": { "type": ["string", "null"] },
      "reduceNavigation": { "type": "boolean" },
      "voiceAction": { "type": ["string", "null"] },
      "accessibilityReport": {
        "type": ["object", "null"],
        "properties": {
          "overallScore": { "type": "number" },
          "visual": { "type": "number" },
          "cognitive": { "type": "number" },
          "navigation": { "type": "number" },
          "language": { "type": "number" },
          "recommendations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
