{
  "manifest_version": 3,
  "name": "AdaptAI",
  "version": "1.0",
  "description": "The web adapts to you. AI-powered accessibility transformations.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "onboarding/onboarding.html",
        "profile/profile.html",
        "styles.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "Adapt this page",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "trigger_adaptation": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Trigger the AI adaptation layer"
    },
    "activate_ai_assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Activate the Floating AI Assistant Panel"
    }
  }
}


